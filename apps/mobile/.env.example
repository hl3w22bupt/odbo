# 心伴AI · 移动端环境变量
# 复制为 .env 并填写后生效。未配置时应用进入「离线演示模式」（内置演示数据）。
#
# 后端服务地址（默认指向本机开发服务器，apps/server 的 HTTP 端口 3111）
# Android 模拟器访问宿主机使用 http://10.0.2.2:3111
# 真机联调请使用局域网 IP，例如 http://192.168.1.100:3111
EXPO_PUBLIC_API_URL=http://10.0.2.2:3111

# 是否启用离线演示模式（true 时即使配置了 API 地址也会使用内置演示数据）
# EXPO_PUBLIC_ENABLE_MOCK=false
