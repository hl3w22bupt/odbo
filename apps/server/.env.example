# ===== 基础 =====
# 服务端口（iii-http worker）
HTTP_PORT=3111
# iii 引擎 WebSocket 地址
III_URL=ws://localhost:49134

# ===== 数据库 =====
DATABASE_URL=postgresql://leo:password@localhost:5432/xinban_dev?schema=public

# ===== JWT =====
ACCESS_TOKEN_SECRET=change-me-access-secret-please
REFRESH_TOKEN_SECRET=change-me-refresh-secret-please
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=30d

# ===== 短信（开发期不配置密钥时，验证码固定 123456）=====
# 可选：dev | aliyun | tencent
SMS_PROVIDER=dev
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=心伴AI
ALIYUN_SMS_TEMPLATE_CODE=SMS_000000
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=心伴AI

# ===== LLM（默认 DeepSeek，OpenAI 兼容）=====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 图像生成（默认豆包 Seedream / 火山引擎）=====
IMAGE_PROVIDER=seedream
SEEDREAM_ACCESS_KEY=
SEEDREAM_SECRET_KEY=
SEEDREAM_ENDPOINT=https://visual.volcengineapi.com

# ===== 支付（占位适配器，真实商户号后补）=====
# 可选：mock | wechat | alipay
PAY_PROVIDER=mock
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ===== 合规 =====
# 防沉迷：深夜时段拦截（23:00-05:59）
ANTI_ADDICTION_LATE_NIGHT=true
# 连续使用拦截窗口（分钟）
ANTI_ADDICTION_WINDOW_MIN=60
# 连续使用上限（分钟）
ANTI_ADDICTION_LIMIT_MIN=60
# 大额支付二次确认阈值（元）
LARGE_PAYMENT_THRESHOLD_CNY=500

# ===== 配额 =====
FREE_DAILY_QUOTA=120

# ===== 聊天 =====
# 回复间隔模拟（毫秒）
CHAT_REPLY_DELAY_MIN_MS=1000
CHAT_REPLY_DELAY_MAX_MS=3000
# 主动分享见闻间隔（分钟）
PROACTIVE_SHARE_INTERVAL_MIN=30
# 主动分享触发所需距离上条用户消息的分钟数
PROACTIVE_SHARE_IDLE_MIN=15
