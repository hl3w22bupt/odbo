{
  "name": "@xinban/server",
  "version": "1.0.0",
  "private": true,
  "description": "心伴AI · 后端服务（iii engine + TypeScript Worker）",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.1",
    "iii-sdk": "^0.22.0",
    "jose": "^6.2.7",
    "openai": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
